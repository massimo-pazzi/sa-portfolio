  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_main" name="Курс «Стандарты сервиса» (SCORM)" processRef="Process_trainer" />
    <bpmn:textAnnotation id="TextAnnotation_03r5n3b">
      <bpmn:text>В поле балла передается null (или 0)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_15p2p1y" associationDirection="None" sourceRef="Event_0t5vcwv" targetRef="TextAnnotation_03r5n3b" />
  </bpmn:collaboration>
  <bpmn:process id="Process_trainer" name="Прохождение тренажера эмоций" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_lms" name="LMS">
        <bpmn:flowNodeRef>lmsPass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lmsProgress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lmsFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0t5vcwv</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_course" name="Тренажер в браузере">
        <bpmn:flowNodeRef>hasCam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inProgress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>score</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>passed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_012ezv4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNoCam</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_emp" name="Сотрудник">
        <bpmn:flowNodeRef>again</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>smile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_06a9exo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:exclusiveGateway id="hasCam" name="Камера есть и согласен на анализ?">
      <bpmn:incoming>t1</bpmn:incoming>
      <bpmn:outgoing>t2</bpmn:outgoing>
      <bpmn:outgoing>t4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="again" name="Еще попытка?">
      <bpmn:incoming>t9</bpmn:incoming>
      <bpmn:outgoing>t10</bpmn:outgoing>
      <bpmn:outgoing>t11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="lmsPass" name="Записать «пройден» и балл">
      <bpmn:incoming>t13</bpmn:incoming>
      <bpmn:outgoing>t14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="confirm" name="Показать подтверждение">
      <bpmn:incoming>t14</bpmn:incoming>
      <bpmn:outgoing>t15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endOk" name="Пройден">
      <bpmn:incoming>t15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="start" name="Открыл тренажер">
      <bpmn:outgoing>t1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="smile" name="Выразить эмоцию и зафиксировать кадр">
      <bpmn:incoming>Flow_1wy2z8d</bpmn:incoming>
      <bpmn:outgoing>t6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_06a9exo">
      <bpmn:incoming>t10</bpmn:incoming>
      <bpmn:incoming>t5b</bpmn:incoming>
      <bpmn:outgoing>Flow_1wy2z8d</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="lmsProgress" name="Записать «в процессе»">
      <bpmn:incoming>t5</bpmn:incoming>
      <bpmn:outgoing>t5b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="t1" sourceRef="start" targetRef="hasCam" />
    <bpmn:sequenceFlow id="t2" name="нет" sourceRef="hasCam" targetRef="endNoCam" />
    <bpmn:sequenceFlow id="t4" name="да" sourceRef="hasCam" targetRef="inProgress" />
    <bpmn:sequenceFlow id="t6" sourceRef="smile" targetRef="score" />
    <bpmn:sequenceFlow id="t8" sourceRef="feedback" targetRef="passed" />
    <bpmn:sequenceFlow id="t9" name="нет" sourceRef="passed" targetRef="again" />
    <bpmn:sequenceFlow id="t13" name="да" sourceRef="passed" targetRef="lmsPass" />
    <bpmn:sequenceFlow id="t10" name="да" sourceRef="again" targetRef="Gateway_06a9exo" />
    <bpmn:sequenceFlow id="t11" name="нет" sourceRef="again" targetRef="lmsFail" />
    <bpmn:sequenceFlow id="t14" sourceRef="lmsPass" targetRef="confirm" />
    <bpmn:sequenceFlow id="t15" sourceRef="confirm" targetRef="endOk" />
    <bpmn:sequenceFlow id="Flow_1wy2z8d" sourceRef="Gateway_06a9exo" targetRef="smile" />
    <bpmn:sequenceFlow id="t5" sourceRef="inProgress" targetRef="lmsProgress" />
    <bpmn:sequenceFlow id="t5b" sourceRef="lmsProgress" targetRef="Gateway_06a9exo" />
    <bpmn:intermediateThrowEvent id="endNoCam" name="Не пройден">
      <bpmn:incoming>t2</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkEventDefinition_0zrw0k2" name="" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="t12" sourceRef="lmsFail" targetRef="endFail" />
    <bpmn:endEvent id="endFail" name="Не пройден">
      <bpmn:incoming>t12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1ko59z3" sourceRef="Event_0t5vcwv" targetRef="lmsFail" />
    <bpmn:serviceTask id="inProgress" name="Передать статус «в процессе»">
      <bpmn:incoming>t4</bpmn:incoming>
      <bpmn:outgoing>t5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="lmsFail" name="Записать «не пройден» и лучший балл">
      <bpmn:incoming>t11</bpmn:incoming>
      <bpmn:incoming>Flow_1ko59z3</bpmn:incoming>
      <bpmn:outgoing>t12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="score" name="Оценить кадр на устройстве, кадр удалить из памяти">
      <bpmn:incoming>t6</bpmn:incoming>
      <bpmn:outgoing>t7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="feedback" name="Показать балл, что удалось, совет">
      <bpmn:incoming>t7</bpmn:incoming>
      <bpmn:outgoing>t8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="t7" sourceRef="score" targetRef="feedback" />
    <bpmn:subProcess id="Activity_012ezv4" triggeredByEvent="true">
      <bpmn:startEvent id="Event_0tsdpnz" name="закрыл тренажер/ сессия прервана">
